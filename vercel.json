{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/engageX/crm",
      "destination": "/index.html"
    },
    {
      "source": "/engageX/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/engageX",
      "destination": "/index.html"
    },
    {
      "source": "/engageX/:path*",
      "destination": "/:path*"
    }
  ]
}
